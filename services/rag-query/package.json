{
  "name": "@ai-pipeline/svc-rag-query",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contract": {
      "@ai-pipeline/source": "./src/contract.ts",
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./schemas": {
      "@ai-pipeline/source": "./src/schemas.ts",
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./service": {
      "@ai-pipeline/source": "./src/service.ts",
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    },
    "./unit": {
      "@ai-pipeline/source": "./src/unit.ts",
      "types": "./dist/unit.d.ts",
      "default": "./dist/unit.js"
    },
    "./api": {
      "@ai-pipeline/source": "./src/api.ts",
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "files": [
    "dist",
    "metadata.json"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@ai-pipeline/ai": "workspace:*",
    "@ai-pipeline/contracts": "workspace:*",
    "@ai-pipeline/metadata": "workspace:*",
    "@ai-pipeline/rag": "workspace:*",
    "@ai-pipeline/runtime": "workspace:*",
    "@mastra/core": "catalog:",
    "@mastra/rag": "catalog:",
    "@restatedev/restate-sdk": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-pipeline/eslint-config": "workspace:*",
    "@ai-pipeline/typescript-config": "workspace:*",
    "@restatedev/restate-sdk-clients": "catalog:",
    "@restatedev/restate-sdk-testcontainers": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "re2js": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
