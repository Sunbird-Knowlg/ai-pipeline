FROM flink:1.20.5-scala_2.12-java11

# apache-flink 1.20.x ships a real prebuilt cp311 wheel (unlike 1.18.1,
# which was source-only and needed a compiler + a pemja/numpy override) —
# no build-essential/python3.11-dev needed here.
RUN apt-get update && \
    apt-get install -y --no-install-recommends python3.11 python3.11-venv python3-pip && \
    rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3.11 /usr/bin/python

# PyFlink's Python KafkaSource/KafkaSink are thin wrappers that call into
# the real Java connector class at runtime — the base flink image ships
# only core Flink, not connectors, so without this jar job startup fails
# with "Could not found the Java class ...KafkaSource.builder". Version
# suffix must match the Flink minor version (1.20.x here).
RUN wget -q -P /opt/flink/lib/ \
    https://repo.maven.apache.org/maven2/org/apache/flink/flink-sql-connector-kafka/3.4.0-1.20/flink-sql-connector-kafka-3.4.0-1.20.jar

COPY core/ /opt/sunbird-ai/core/
COPY jobs/enrichment_router/ /opt/sunbird-ai/jobs/enrichment_router/

# Plain (non-editable) installs, explicitly via python3.11's own pip — the
# image is built once and never edited in place, so there's no reason to
# want -e here, and -e requires a PEP 660-capable build backend that isn't
# reliably resolvable through apt's python3-pip (which targets the base
# image's default python, not 3.11, and can be too old for PEP 660 anyway).
RUN python3.11 -m pip install --no-cache-dir --upgrade pip && \
    python3.11 -m pip install --no-cache-dir /opt/sunbird-ai/core/ && \
    python3.11 -m pip install --no-cache-dir apache-flink==1.20.5 && \
    python3.11 -m pip install --no-cache-dir /opt/sunbird-ai/jobs/enrichment_router/

WORKDIR /opt/sunbird-ai/jobs/enrichment_router

# Invoked directly via python3.11, not `flink run` — `flink run` submits
# via REST to a JobManager it expects already running (default
# localhost:8081), which nothing in this container starts, causing a
# deterministic "Connection refused: /0.0.0.0:8081" on every execute().
# Running the script directly lets get_execution_environment() create a
# real embedded local MiniCluster in-process instead, no REST/networking
# involved — the single-process, no-separate-JM/TM model this chart
# actually intends (see py-flink chart's templates/deployment.yaml).
ENTRYPOINT ["python3.11", "enrichment_router/main.py", "--config", "config.yaml"]
