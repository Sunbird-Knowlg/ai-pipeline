{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Path-free compiler options only: relative paths in an extended config resolve against the file
  // they are written in, so rootDir/outDir/include/exclude stay in each package's own tsconfig.json.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  }
}
