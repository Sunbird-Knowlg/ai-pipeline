{
  "name": "@ai-pipeline/observability",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./logger": {
      "@ai-pipeline/source": "./src/logger.ts",
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    },
    "./telemetry": {
      "@ai-pipeline/source": "./src/telemetry.ts",
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@ai-pipeline/eslint-config": "workspace:*",
    "@ai-pipeline/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
