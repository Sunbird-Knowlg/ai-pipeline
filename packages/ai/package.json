{
  "name": "@ai-pipeline/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./embed": {
      "@ai-pipeline/source": "./src/embed.ts",
      "types": "./dist/embed.d.ts",
      "default": "./dist/embed.js"
    },
    "./errors": {
      "@ai-pipeline/source": "./src/errors.ts",
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./generate": {
      "@ai-pipeline/source": "./src/generate.ts",
      "types": "./dist/generate.d.ts",
      "default": "./dist/generate.js"
    },
    "./language-model": {
      "@ai-pipeline/source": "./src/language-model.ts",
      "types": "./dist/language-model.d.ts",
      "default": "./dist/language-model.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "catalog:",
    "@opentelemetry/api": "catalog:",
    "ai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-pipeline/eslint-config": "workspace:*",
    "@ai-pipeline/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
