{
  "name": "@ai-pipeline/blob-storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./upload": {
      "@ai-pipeline/source": "./src/upload.ts",
      "types": "./dist/upload.d.ts",
      "default": "./dist/upload.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@azure/identity": "4.13.0",
    "@azure/storage-blob": "12.30.0"
  },
  "devDependencies": {
    "@ai-pipeline/eslint-config": "workspace:*",
    "@ai-pipeline/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
